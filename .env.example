# ezChat 环境变量模板
# 复制此文件为 .env 并填入实际值

# 服务端
PORT=3000
NODE_ENV=development

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ezchat
DB_USER=root
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# 邮件（用于发送验证码）— 163 邮箱示例
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USER=yourname@163.com
MAIL_PASS=163_auth_code_here
MAIL_FROM=yourname@163.com

# 客户端地址 (CORS) — 注意：语音通话功能需要 HTTPS
CLIENT_URL=https://localhost:5173
